<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.madskvist.orderbook</string>

    <!-- Optager orderbook-spread til research. Rører IKKE handelsmotoren. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>cd "/Users/madskvist/Documents/GitHub/REAL TRADING BOT" &amp;&amp; exec .venv/bin/python research/orderbook_recorder.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/madskvist/Documents/GitHub/REAL TRADING BOT</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- Genstart hvis processen dør. En optager der stoppede for tre uger siden
         er værre end ingen optager, fordi vi ville stole på dataen. -->
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/madskvist/Documents/GitHub/REAL TRADING BOT/data/orderbook/_logs/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/madskvist/Documents/GitHub/REAL TRADING BOT/data/orderbook/_logs/launchd.err.log</string>

    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
